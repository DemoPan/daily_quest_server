# 服务运行端口
PORT=5000

# MongoDB Atlas 云数据库连接串
# 格式: mongodb+srv://<用户名>:<密码>@<集群地址>/daily_quest?retryWrites=true&w=majority
# 注意: 请将 <用户名> 和 <密码> 替换为你自己在 MongoDB Atlas 创建的 Database User
MONGODB_URI=mongodb+srv://admin:password123@cluster0.xxxx.mongodb.net/daily_quest?retryWrites=true&w=majority

# 运行环境
NODE_ENV=development
